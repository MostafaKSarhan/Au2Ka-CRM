server {
    listen 80;
    server_name au2ka.fasla.cloud;

    root /var/www/faslatech/Au2Ka-CRM/frontend/dist;
    index index.html;

    # Allow larger uploads (car photos/videos up to 10MB in the backend).
    # The nginx default is only 1MB, which silently rejects real photos.
    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5123;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Uploaded photos/videos are served by the backend (fastify-static at
    # /uploads/). Without this the images 404 on the live site.
    location /uploads/ {
        proxy_pass http://127.0.0.1:5123;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
