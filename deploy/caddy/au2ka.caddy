# Au2Ka CRM على Caddy — يُستورد من /etc/caddy/Caddyfile بسطر:
#
#     import /etc/caddy/au2ka.caddy
#
# Caddy يصدر شهادة HTTPS ويجددها وحده، فلا حاجة لـ certbot. وهو ما يعمل
# على خادم FaslaTech بالفعل، بينما ملفات deploy/nginx/ لخادم يستعمل nginx.
#
# الواجهة تنادي نفس العنوان الذي قُدِّمت منه، فالمسارات الثلاثة تحت تصل
# الواجهة بالباكند. تغيير النطاق هنا وحده ينقل النظام إلى خادم آخر.

au2ka.faslacloud.com {
	encode gzip zstd

	# صور السيارات حتى 10 ميجابايت في الباكند
	request_body {
		max_size 20MB
	}

	# الـ API وملفات الرفع يقدمهما الباكند على 5123
	handle /api/* {
		reverse_proxy 127.0.0.1:5123 {
			# تنزيل النسخة الاحتياطية يأخذ وقتًا على قاعدة كبيرة
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:5123
	}

	handle {
		root * /var/www/faslatech/Au2Ka-CRM/frontend/dist

		# عامل الخدمة وملف البيان لا يُخزَّنان إطلاقًا: لو خُزِّن عامل
		# الخدمة بقي المستخدمون على نسخة قديمة من التطبيق ولم تصلهم
		# أي تحديثات.
		@sw path /sw.js /manifest.webmanifest
		header @sw Cache-Control "no-cache, no-store, must-revalidate"

		# ملفات البناء تحمل بصمة في أسمائها، فتخزينها طويلًا آمن
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# تطبيق صفحة واحدة: أي مسار غير موجود يعود إلى index.html
		try_files {path} /index.html
		file_server
	}
}
