# بيئة الإنتاج لباكند Au2Ka — تُنسخ إلى backend/.env على الخادم.
#
#   sudo install -o www-data -g www-data -m 600 /dev/null backend/.env
#   sudo -u www-data nano backend/.env
#
# الملف يحمل كل أسرار النظام، فصلاحياته 600 ولا يُرفع إلى Git أبدًا.

# قاعدة البيانات — مستخدم خاص بالتطبيق، لا root
DATABASE_URL="mysql://au2ka:CHANGE-ME@127.0.0.1:3306/au2ka_crm"

# مفتاح توقيع الجلسات. وَلِّده ولا تنسخه من مكان آخر:
#   openssl rand -base64 48
# تغييره يُخرج كل المستخدمين من النظام.
JWT_SECRET="CHANGE-ME"

PORT=5123
HOST=127.0.0.1
NODE_ENV=production

# المواقع المسموح لها بمناداة الـ API. اتركه فارغًا إذا كان nginx يقدّم
# الواجهة والـ API على نفس النطاق (الإعداد الافتراضي)، واضبطه إذا كان
# الـ API على نطاق فرعي مستقل:
# CORS_ORIGINS=https://au2ka.fasla.cloud

# مسار mysqldump لو لم يكن في PATH (يستخدمه زر النسخة الاحتياطية)
# MYSQLDUMP_PATH=/usr/bin/mysqldump

# ------------------------------------------------------------------
# بيانات العميل — تُملأ عند توفّرها، والنظام يعمل بدونها
# ------------------------------------------------------------------

# واتساب الرسمي (M8): التوكن هنا يسبق المحفوظ في قاعدة البيانات، ولا
# يظهر في أي رد من الـ API. باقي الإعدادات من شاشة "البيانات الأساسية".
# WHATSAPP_ACCESS_TOKEN=

# الفوترة الإلكترونية (M9): الرقم الضريبي وبيانات المنشأة وشهادة CSID
# تُدخل من شاشة الفوترة في لوحة التحكم، لا من هنا.
